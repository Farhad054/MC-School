          "title": "Dreieck, Kreis und Rechteck",
          "items": [
            {
              "label": "3a",
              "text": "Dreieck: Seiten 6, 8, 10 cm; Umfang 24 cm."
            },
            {
              "label": "3b",
              "text": "Fläche des Dreiecks: 6 · 8 / 2 = 24 cm²."
            },
            {
              "label": "4a",
              "text": "Kreisdurchmesser d = 6 cm."
            },
            {
              "label": "4b",
              "text": "Kreisumfang U = 6π cm ≈ 18,85 cm."
            },
            {
              "label": "5a",
              "text": "Rechteckumfang = 2 · (8 + 4) = 24 cm."
            },
            {
              "label": "5b",
              "text": "Rechteckfläche A = 8 · 4 = 32 cm²."
